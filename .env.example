# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Host 'postgres-15' is the container name of the existing PostgreSQL 15
DATABASE_URL=postgresql://billing_user:<password>@postgres-15:5432/v3netbill?schema=public

# PostgreSQL individual variables
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=
POSTGRES_DB=v3netbill

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# Frontend dev server (Vite) — host yang boleh akses, pisah koma utk lebih dari satu.
# Nilai domain publik TIDAK disimpan di repo; isi di .env lokal.
ALLOWED_HOSTS=

# Backend
PORT=3000
NODE_ENV=development

# SMTP (laporan tutup hari via email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_ENCRYPTION=tls

# Telegram (laporan tutup hari via bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tujuan laporan tutup hari (pisah koma utk lebih dari satu)
LAPORAN_EMAIL_TUJUAN=